# Copier en .env.local (jamais commité) et dans Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API. La clé service_role ne va JAMAIS dans le navigateur.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secret de signature (64 caractères aléatoires) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Adresse publique EXACTE du site, sans / final. Les clés d'accès ne marchent que sur ce domaine.
SITE_URL=https://gost31.vercel.app
